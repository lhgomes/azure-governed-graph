<!-- Responses front door, not Foundry BYOM: preserve the approved agent name and caller identity. -->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization" failed-validation-httpcode="401">
      <client-application-ids><application-id>{{model-runtime-client-id}}</application-id></client-application-ids>
      <audiences><audience>https://ai.azure.com</audience><audience>https://ai.azure.com/</audience></audiences>
    </validate-azure-ad-token>
    <choose>
      <when condition='@(!System.Text.RegularExpressions.Regex.IsMatch(context.Request.Headers.GetValueOrDefault("X-Journey-ID", ""), "^J-[a-fA-F0-9]{32}$"))'>
        <return-response><set-status code="400" reason="Journey correlation required" /></return-response>
      </when>
      <when condition='@{
        var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
        var agent = body["agent_reference"] as Newtonsoft.Json.Linq.JObject;
        if (agent == null) { return true; }
        var name = (string)agent["name"];
        return (string)agent["type"] != "agent_reference"
          || body["model"] != null || body["instructions"] != null || body["tools"] != null || body["text"] != null
          || !(name == "gg-counsellor" || name == "gg-counsellor-voice-compact"); }'>
        <return-response><set-status code="400" reason="Approved agent required" /></return-response>
      </when>
    </choose>
    <llm-token-limit counter-key='@("gg-conversation:" + context.Request.Headers.GetValueOrDefault("X-Journey-ID", ""))'
      tokens-per-minute="__CONVERSATION_TOKENS_PER_MINUTE__" token-quota="120000" token-quota-period="Daily" estimate-prompt-tokens="true" />
    <set-header name="X-Authenticated-Member" exists-action="delete" />
  </inbound>
  <!-- Do not replay a possibly accepted model request or change its model on failure. -->
  <backend><forward-request timeout="25" /></backend>
  <outbound><base /></outbound>
  <!-- Name the daily-quota refusal so the host escalates with a conversation-limit reason, not an outage. -->
  <on-error>
    <base />
    <choose>
      <when condition='@(context.LastError != null &amp;&amp; context.LastError.Source == "llm-token-limit"
          &amp;&amp; (context.LastError.Reason ?? "").IndexOf("Quota", System.StringComparison.OrdinalIgnoreCase) >= 0)'>
        <return-response>
          <set-status code="403" reason="Conversation token quota exceeded" />
          <set-header name="X-GG-Limit" exists-action="override"><value>conversation-token-quota</value></set-header>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
