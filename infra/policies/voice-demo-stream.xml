<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(__DISABLED__)"><return-response><set-status code="404" reason="Not Found" /></return-response></when>
      <when condition="@(context.Request.Url.Query.Count > 0)"><return-response><set-status code="400" reason="Query credentials forbidden" /></return-response></when>
    </choose>
    <check-header name="Origin" failed-check-httpcode="403" failed-check-error-message="Demo origin required" ignore-case="false"><value>__ORIGIN__</value></check-header>
    <validate-jwt token-value="@(System.Text.RegularExpressions.Regex.Match(context.Request.Headers.GetValueOrDefault(&quot;Cookie&quot;, &quot;&quot;), &quot;(?:^|;\\s*)__Secure-gg-voice-demo=([^;]+)&quot;).Groups[1].Value)" require-signed-tokens="true" require-expiration-time="true" failed-validation-httpcode="401">
      <openid-config url="https://login.microsoftonline.com/__TENANT__/v2.0/.well-known/openid-configuration" />
      <audiences><audience>__CLIENT__</audience></audiences>
      <issuers><issuer>https://login.microsoftonline.com/__TENANT__/v2.0</issuer></issuers>
      <required-claims>
        <claim name="tid"><value>__TENANT__</value></claim>
        <claim name="oid"><value>__OPERATOR__</value></claim>
        <claim name="scp" match="any" separator=" "><value>VoiceDemo.Access</value></claim>
        <claim name="roles" match="any"><value>VoiceDemo.Presenter</value></claim>
        <claim name="azp" match="any"><value>__CLIENT__</value><value>04b07795-8ddb-461a-bbee-02f9e1bf7b46</value></claim>
      </required-claims>
    </validate-jwt>
    <rate-limit-by-key calls="3" renewal-period="60" counter-key="gg-dev-voice-stream" />
  </inbound>
  <backend><base /></backend><outbound><base /></outbound><on-error><base /></on-error>
</policies>
