<!-- Read-only facade over the administrator (B1). Member scoping: the authenticated member comes
     ONLY from the validated token, never from the client. -->
<policies>
  <inbound>
    <base />
    <set-variable name="journeyId" value='@(context.Request.Headers.GetValueOrDefault("X-Journey-ID", context.RequestId.ToString()))' />
    <trace source="member-values" severity="information">
      <message>member_values_call</message>
      <metadata name="journey_id" value='@((string)context.Variables["journeyId"])' />
    </trace>
    <choose>
      <when condition='@(context.Request.Method != "GET")'>
        <return-response><set-status code="405" reason="Read-only facade (B1)" /></return-response>
      </when>
    </choose>
    <validate-jwt header-name="Authorization" require-scheme="Bearer" require-signed-tokens="true" require-expiration-time="true" clock-skew="0" failed-validation-httpcode="401" output-token-variable-name="jwt">
      <issuer-signing-keys><key n="{{member-token-modulus}}" e="{{member-token-exponent}}" /></issuer-signing-keys>
      <audiences><audience>{{member-token-audience}}</audience></audiences>
      <issuers><issuer>{{member-token-issuer}}</issuer></issuers>
      <required-claims><claim name="acr" match="all"><value>stepup</value></claim></required-claims>
    </validate-jwt>
    <choose>
      <when condition='@(string.IsNullOrWhiteSpace(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("member_ref", "")))'>
        <return-response><set-status code="401" reason="Verified member claim required" /></return-response>
      </when>
    </choose>
    <choose>
      <when condition='@{ var jwt = (Jwt)context.Variables["jwt"]; return jwt.Algorithm != "RS256" || !jwt.IssuedAt.HasValue || !jwt.ExpirationTime.HasValue || jwt.IssuedAt.Value &gt; DateTime.UtcNow || (jwt.ExpirationTime.Value - jwt.IssuedAt.Value).TotalSeconds &gt; 900 || jwt.ExpirationTime.Value &lt;= jwt.IssuedAt.Value; }'>
        <return-response><set-status code="401" reason="Invalid member token lifetime" /></return-response>
      </when>
    </choose>
    <set-header name="X-Authenticated-Member" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("member_ref", ""))</value>
    </set-header>
    <choose>
      <when condition='@(context.Request.MatchedParameters.GetValueOrDefault("memberRef", "") != ((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("member_ref", ""))'>
        <trace source="member-values" severity="error">
          <message>member_scope_violation</message>
          <metadata name="journey_id" value='@((string)context.Variables["journeyId"])' />
        </trace>
        <return-response><set-status code="403" reason="Member scoping violation" /></return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key='@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", "anon"))' />
    <set-backend-service backend-id="administrator-values" />
  </inbound>
  <backend>
    <retry condition='@(context.Request.Method == "GET" &amp;&amp; (context.Response == null || context.Response.StatusCode &gt;= 500))' count="2" interval="1" delta="1" max-interval="4" first-fast-retry="false">
      <forward-request timeout="3" />
    </retry>
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
