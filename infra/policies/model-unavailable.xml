<policies>
  <inbound>
    <base />
    <return-response>
      <set-status code="503" reason="Approved agent configuration incomplete" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>{"error":{"code":"AgentConfigurationIncomplete","message":"Approved agent versions are not configured."}}</set-body>
    </return-response>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
