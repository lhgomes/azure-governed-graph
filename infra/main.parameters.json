{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "namingSeed": { "value": "${GOVERNEDGRAPH_NAMING_SEED=}" },
    "location": { "value": "${AZURE_LOCATION=swedencentral}" },
    "searchLocation": { "value": "${AZURE_SEARCH_LOCATION=swedencentral}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "memberTokenIssuer": { "value": "${MEMBER_TOKEN_ISSUER}" },
    "memberTokenAudience": { "value": "${MEMBER_TOKEN_AUDIENCE=gg-apim}" },
    "memberTokenPublicJwk": { "value": "${MEMBER_TOKEN_PUBLIC_JWK}" },
    "deployDevIssuer": { "value": "${GOVERNEDGRAPH_ENABLE_DEV_MEMBER_ISSUER=false}" },
    "deployVoiceDemo": { "value": "${DEPLOY_VOICE_DEMO=false}" },
    "voiceDemoClientId": { "value": "${VOICE_DEMO_CLIENT_ID=}" },
    "voiceDemoOperatorId": { "value": "${VOICE_DEMO_OPERATOR_ID=}" },
    "deployDevFixtures": { "value": "${DEPLOY_DEV_FIXTURES=false}" },
    "devFixturesImage": { "value": "${DEV_FIXTURES_IMAGE=}" },
    "p2ContainerImage": { "value": "${P2_CONTAINER_IMAGE=}" },
    "p2ScheduleEnabled": { "value": "${P2_SCHEDULE_ENABLED=false}" },
    "p2ScheduleProof": { "value": "${P2_SCHEDULE_PROOF=false}" },
    "orchestratorImage": { "value": "${SERVICE_ORCHESTRATOR_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "strategyServiceImage": { "value": "${SERVICE_STRATEGY_SERVICE_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "memberValuesImage": { "value": "${SERVICE_MEMBER_VALUES_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "contentPublisherImage": { "value": "${CONTENT_PUBLISHER_IMAGE=}" },
    "devIssuerImage": { "value": "${DEV_ISSUER_IMAGE=}" },
    "strategyApiClientId": { "value": "${STRATEGY_API_CLIENT_ID=}" },
    "strategyRecoveryOperatorId": { "value": "${STRATEGY_RECOVERY_OPERATOR_ID=}" },
    "p2MlArtifactContainers": { "value": "${P2_ML_ARTIFACT_CONTAINERS=[]}" },
    "counsellorAgentName": { "value": "${AZURE_AI_AGENT_NAME=gg-counsellor}" },
    "counsellorAgentVersion": { "value": "${AZURE_AI_AGENT_VERSION=}" },
    "voiceCompactAgentVersion": { "value": "${AZURE_AI_VOICE_COMPACT_VERSION=}" },
    "intentAgentVersion": { "value": "${AZURE_AI_INTENT_AGENT_VERSION=}" },
    "understandingAgentVersion": { "value": "${AZURE_AI_UNDERSTANDING_AGENT_VERSION=}" },
    "reviewAgentVersion": { "value": "${AZURE_AI_REVIEW_AGENT_VERSION=}" },
    "writerApproval": { "value": "${GOVERNEDGRAPH_WRITER_APPROVAL_JSON=null}" },
    "traceSyntheticConversations": { "value": "${GOVERNEDGRAPH_TRACE_SYNTHETIC_CONVERSATIONS=false}" },
    "voiceDraftModel": { "value": "${GOVERNEDGRAPH_VOICE_DRAFT_MODEL=gpt-counsellor}" },
    "deployFabric": { "value": false },
    "deploySyntheticContactCentre": { "value": "${GOVERNEDGRAPH_SYNTHETIC_CONTACT_CENTRE=false}" },
    "contactCentreImage": { "value": "${SERVICE_CONTACT_CENTRE_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "contactCentreApiClientId": { "value": "${CONTACT_CENTRE_CLIENT_ID=}" },
    "contactCentreAudience": { "value": "${CONTACT_CENTRE_AUDIENCE=}" },
    "contactCentreUrl": { "value": "${CONTACT_CENTRE_PRODUCTION_URL=}" },
    "onCallEmail": { "value": "${ON_CALL_EMAIL}" },
    "promptShieldsFailureThreshold": { "value": "${PROMPT_SHIELDS_FAILURE_THRESHOLD=3}" },
    "resourceGroupName": { "value": "${GOVERNEDGRAPH_RESOURCE_GROUP_NAME=}" }
  }
}
