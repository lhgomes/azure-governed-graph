{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "540443896372527424"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Synthetic development only. Never deploy this issuer in production."
      }
    },
    "token": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "issuerIdentityId": {
      "type": "string"
    },
    "issuerClientId": {
      "type": "string"
    },
    "memberTokenIssuer": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2024-03-01",
      "name": "job-gg-dev-member-issuer",
      "location": "[parameters('location')]",
      "tags": {
        "data": "synthetic",
        "purpose": "dev-only-member-issuer"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('issuerIdentityId'))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-gg-{0}', parameters('token')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "triggerType": "Manual",
          "replicaTimeout": 600,
          "replicaRetryLimit": 0,
          "manualTriggerConfig": {
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": [
            {
              "server": "[format('crgg{0}.azurecr.io', take(parameters('token'), 16))]",
              "identity": "[parameters('issuerIdentityId')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "issuer",
              "image": "[parameters('image')]",
              "command": [
                "python",
                "-m",
                "governedgraph.dev.issue_member_token"
              ],
              "args": [
                "--public-jwk"
              ],
              "env": [
                {
                  "name": "GOVERNEDGRAPH_ENABLE_DEV_MEMBER_ISSUER",
                  "value": "true"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[parameters('issuerClientId')]"
                },
                {
                  "name": "AZURE_KEY_VAULT_URL",
                  "value": "[reference(resourceId('Microsoft.KeyVault/vaults', format('kv-gg-{0}', take(parameters('token'), 13))), '2023-07-01').vaultUri]"
                },
                {
                  "name": "MEMBER_TOKEN_ISSUER",
                  "value": "[parameters('memberTokenIssuer')]"
                },
                {
                  "name": "APIM_GATEWAY_URL",
                  "value": "[format('https://apim-gg-{0}.azure-api.net', parameters('token'))]"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ]
        }
      }
    }
  ]
}